* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Roboto, sans-serif;
    user-select: none;
}

body, html {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #000;
}

#ui-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
}

#hud {
    position: absolute;
    top: 20px;
    left: 20px;
    color: #fff;
    font-size: 15px;
    font-weight: bold;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

#mode-status, #ammo-status, #wanted-container {
    background: rgba(0, 0, 0, 0.75);
    padding: 8px 14px;
    border-radius: 6px;
    border-left: 4px solid #00ffcc;
}

#wanted-container {
    border-left: 4px solid #ffcc00;
    color: #ffcc00;
    font-size: 18px;
}

#crosshair {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #00ffcc;
    font-size: 26px;
    font-weight: bold;
    display: none;
}

#prompt {
    background: rgba(255, 204, 0, 0.9);
    color: #000;
    padding: 8px 14px;
    border-radius: 6px;
    display: none;
    font-size: 14px;
}

#inventory-bar {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.85);
    border: 1px solid #00ffcc;
    padding: 10px 20px;
    border-radius: 8px;
    color: #fff;
    text-align: center;
}

.inv-title {
    font-size: 12px;
    color: #aaa;
    margin-bottom: 4px;
}

#weapon-list {
    font-size: 14px;
    color: #00ffcc;
    font-weight: bold;
}

#start-screen {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(5, 5, 15, 0.95);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: #fff;
    text-align: center;
    pointer-events: auto;
    padding: 20px;
}

#start-screen h1 {
    font-size: 42px;
    color: #00ffcc;
    margin-bottom: 15px;
    text-shadow: 0 0 15px #00ffcc;
}

.story, .controls-info {
    max-width: 500px;
    margin-bottom: 15px;
    line-height: 1.5;
    background: rgba(255, 255, 255, 0.05);
    padding: 12px;
    border-radius: 8px;
}

#start-btn {
    padding: 12px 35px;
    font-size: 18px;
    font-weight: bold;
    color: #000;
    background-color: #00ffcc;
    border: none;
    border-radius: 25px;
    cursor: pointer;
    box-shadow: 0 0 15px #00ffcc;
}
